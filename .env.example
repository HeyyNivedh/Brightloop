# ==========================================
# Brightloop Subscription Management System
# Environment Configuration Template
# ==========================================

# Database Connection (PostgreSQL)
# For local embedded postgres: postgresql://postgres:postgres@localhost:54333/brightloop?schema=public
# For custom postgres/Docker: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:54333/brightloop?schema=public"

# Database Server Configuration (for local embedded postgres daemon)
DB_PORT="54333"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="brightloop"

# JWT & Session Security (Use a cryptographically secure random string with >= 32 chars)
JWT_SECRET="replace-with-a-secure-random-32-char-secret-key-in-production"
JWT_EXPIRES_IN="7d"

# Password Reset Token Expiry (in minutes)
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES="60"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment (development | test | production)
NODE_ENV="development"

# Email Adapter Mode: 'development' (in-memory/console logging) or 'smtp' (production mailer)
EMAIL_ADAPTER="development"

# Optional SMTP Configuration (only required if EMAIL_ADAPTER="smtp")
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"
# SMTP_FROM="noreply@brightloop.local"
